      "name": "00 - Autenticación",
      "description": "Login de cada rol. Cambiar los DNI por los de tu base de datos.",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"10000001\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda el token en {{token_admin}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token_admin', res.data.token);",
                  "    console.log('Token guardado en {{token_admin}}');",
                  "}",
                  "pm.test('Respuesta con estructura uniforme', function () {",
                  "    pm.expect(res).to.have.property('code');",
                  "    pm.expect(res).to.have.property('status');",
                  "    pm.expect(res).to.have.property('data');",
                  "});"
                ]
              }
            }
          ]
        },
